# XVault environment example (no real secrets)

# Individual create-add-list fixture (no live credentials required)
# XVAULT_RUNTIME=fixture
# XVAULT_HOME=
# XVAULT_STATE_FILE=
# XVAULT_FIXTURE_IPFS_FILE=
# XVAULT_MASTER_PASSWORD=

# Contract / cluster endpoint (live path; env class OPEN)
HOTPOCKET_WS_URL=ws://localhost:8081

# Xahau testnet endpoint and wallet seed
XRPL_WS_URL=wss://xahau-testnet.example
XRPL_SEED=

# Client runtime
XVAULT_MASTER_PASSWORD=
XVAULT_VAULT_SALTS={}
XVAULT_ENABLE_TEAM_MODE=true

# QuickNode IPFS
QUICKNODE_IPFS_API_KEY=
QUICKNODE_IPFS_API_BASE=https://api.quicknode.com/ipfs/rest
QUICKNODE_GATEWAY=https://your-gateway-name.quicknode-ipfs.com

# Contract runtime toggles (host-side)
ENABLE_TEAM_MODE=true
ENABLE_MUTABLE_URITOKENS=false
XVAULT_DEV_XRPL_FALLBACK=false
XVAULT_STATE_FILE=./state/xvault-state.json
